@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authorization;
@using MyPortfolioWebsite.Data
@using MyPortfolioWebsite.Services
@inject AppDbContext DbContext
@inject IVersionService VersionService
@{
    var email = User.FindFirst(ClaimTypes.Email)?.Value;

    string? dbPic = null;
    if(!string.IsNullOrWhiteSpace(email))
    {
        dbPic = DbContext.AppUsers.Where(u => u.Email == email).Select(u => u.ProfilePictureUrl).FirstOrDefault();
    }

    var googlePic = User.FindFirst("urn:google:picture")?.Value;
    var profilePic = !string.IsNullOrWhiteSpace(dbPic) ? dbPic : (!string.IsNullOrWhiteSpace(googlePic) ? googlePic : "/images/default-profile.png");

    var cacheBust = "?v=" + DateTime.UtcNow.Ticks;

    if (!string.IsNullOrWhiteSpace(profilePic) && !profilePic.Contains("?"))
    {
        profilePic += cacheBust;    
    }
}
<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8"/>
        <title>My Portfolio Website</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    </head>
    <body class="bg-light">

        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <span class="navbar-brand">My Portfolio Website</span>
                <div class="d-flex">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="btn btn-outline-light" asp-page="/Account/Logout"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                    }
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row vh-100">

                <!-- Sidebar -->
                <div class="col-md-3 bg-white shadow-sm pt-4">
                    <div class="text-center mb-4">
                        <img src="@profilePic" class="rounded-circle" style="width:100px; height:100px;" alt="Profile Picture" />
                        <h5 class="mt-2">Welcome, @User.Identity?.Name</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a asp-page="/Dashboard/EditPortfolio" class="list-group-item list-group-item-action"><i class="bi bi-pencil-square me-2"></i>Edit Portfolio</a>
                        <a asp-page="/Dashboard/EditProfile" class="list-group-item list-group-item-action"><i class="bi bi-gear me-2"></i>Edit Profile</a>
                        <a asp-page="/Dashboard/UpdateLog" class="list-group-item list-group-item-action"><i class="bi bi-clock-history me-2"></i>Update Log</a>
                    </div>
                    <footer class="text-center mt-4">
                        <small class="text-muted">Version: @VersionService.GetCurrentVersion()</small>
                    </footer>
                </div>

                <!-- Main Content -->
                <div class="col-md-9 p-4">@RenderBody()</div>

            </div>
        </div>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
