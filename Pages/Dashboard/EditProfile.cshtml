@page
@model MyPortfolioWebsite.Pages.Dashboard.EditProfileModel
@{
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Profile";

    var googlePic = User.FindFirst("urn:google:picture")?.Value;
    var displayPic = Model.Profile.ProfilePictureUrl ?? googlePic ?? "/images/default-profile.png";

    if (!string.IsNullOrEmpty(displayPic) && displayPic.StartsWith("/uploads"))
    {
        displayPic += "?v=" + DateTime.UtcNow.Ticks;
    }
}

<div class="profile-page">
    <div class="profile-header">
        <div class="profile-title">
            <span class="profile-icon">
                <i class="bi bi-person-gear"></i>
            </span>
            <div>
                <p class="eyebrow">Dashboard</p>
                <h1>Edit profile</h1>
                <p class="profile-subtitle">Manage your personal details, contact information, and portfolio photo.</p>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="profile-panel">
                    <section class="settings-section">
                        <h2>Personal details</h2>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Profile.FirstName" class="form-label">Name</label>
                                <input asp-for="Profile.FirstName" class="form-control" />
                                <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.LastName" class="form-label">Surname</label>
                                <input asp-for="Profile.LastName" class="form-control" />
                                <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.DateOfBirth" class="form-label">Date of birth</label>
                                <input asp-for="Profile.DateOfBirth" type="date" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.Gender" class="form-label">Gender</label>
                                <select asp-for="Profile.Gender" class="form-select">
                                    <option value="">Select gender</option>
                                    <option>Male</option>
                                    <option>Female</option>
                                    <option>Unspecified</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h2>Contact</h2>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Profile.Email" class="form-label">Primary email</label>
                                <input asp-for="Profile.Email" class="form-control" readonly />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.AlternateEmail" class="form-label">Alternate email</label>
                                <input name="Profile.AlternateEmail" value="@(Model.Profile.PendingAlternateEmail ?? Model.Profile.AlternateEmail)" class="form-control" />
                                @if (!string.IsNullOrWhiteSpace(Model.Profile.PendingAlternateEmail))
                                {
                                    <div class="form-text text-warning">
                                        Verification pending for @Model.Profile.PendingAlternateEmail
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(Model.Profile.AlternateEmail) && Model.Profile.IsAlternateEmailVerified)
                                {
                                    <div class="form-text text-success">
                                        Alternate email verified
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="settings-section">
                        <h2>Public portfolio</h2>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Profile.PublicSlug" class="form-label">Public link name</label>
                                <input asp-for="Profile.PublicSlug" class="form-control" placeholder="jacob-kyle-farrugia" />
                                <span asp-validation-for="Profile.PublicSlug" class="text-danger"></span>
                                <div class="form-text">Use lowercase letters, numbers, and hyphens.</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.PortfolioHeadline" class="form-label">Portfolio headline</label>
                                <input asp-for="Profile.PortfolioHeadline" class="form-control" placeholder="Junior .NET Developer" />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="Profile.IsPortfolioPublic" class="form-check-input" type="checkbox" />
                                    <label asp-for="Profile.IsPortfolioPublic" class="form-check-label">
                                        Make my portfolio public
                                    </label>
                                </div>
                            </div>

                            @if (Model.Profile.IsPortfolioPublic && !string.IsNullOrWhiteSpace(Model.PublicPortfolioUrl))
                            {
                                <div class="col-12">
                                    <div class="public-link-tools">
                                        <div>
                                            <span class="public-link-label">Public URL</span>
                                            <a href="@Model.PublicPortfolioUrl" target="_blank" rel="noopener noreferrer">@Model.PublicPortfolioUrl</a>
                                        </div>

                                        <div class="public-link-actions">
                                            <a class="btn btn-outline-primary btn-sm" href="@Model.PublicPortfolioUrl" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>View
                                            </a>
                                            <button class="btn btn-outline-secondary btn-sm" type="button" data-copy-url="@Model.PublicPortfolioUrl">
                                                <i class="bi bi-clipboard me-1"></i>Copy
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="settings-section">
                        <h2>About</h2>

                        <div class="mb-3">
                            <label asp-for="Profile.Description" class="form-label">Description</label>
                            <textarea asp-for="Profile.Description" class="form-control" rows="5"></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Profile.JobTitle" class="form-label">Job title</label>
                                <input asp-for="Profile.JobTitle" class="form-control" placeholder="Junior .NET Developer" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.Location" class="form-label">Location</label>
                                <input asp-for="Profile.Location" class="form-control" placeholder="Malta" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.GitHubUrl" class="form-label">GitHub URL</label>
                                <input asp-for="Profile.GitHubUrl" class="form-control" placeholder="https://github.com/username" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Profile.LinkedInUrl" class="form-label">LinkedIn URL</label>
                                <input asp-for="Profile.LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/username" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Profile.Skills" class="form-label">Skills</label>
                                <input asp-for="Profile.Skills" class="form-control" placeholder="C#, ASP.NET Core, SQL Server, JavaScript" />
                                <div class="form-text">Separate skills with commas. Leave blank to use programming languages from your projects automatically.</div>
                            </div>
                        </div>
                        
                        <div>
                            <label asp-for="Profile.AccountCreated" class="form-label">Account created</label>
                            <input value="@Model.Profile.AccountCreated.ToString("yyyy-MM-dd")" class="form-control" readonly />
                        </div>
                    </section>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="profile-photo-panel">
                    <h2>Profile photo</h2>

                    <div class="profile-photo-wrap">
                        <img src="@displayPic" class="profile-photo-preview" alt="Profile picture" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload new photo</label>
                        <input id="profilePhotoInput" type="file" name="ProfilePictureFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <input id="croppedPhotoData" type="hidden" name="CroppedPhotoData" />

                        <div id="photoEditor" class="photo-editor d-none">
                            <img id="photoEditorImage" class="photo-editor-image" alt="Selected profile preview" />
                        </div>
                        <div class="form-text">JPG, PNG, or WEBP. Maximum size 2 MB.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2 me-1"></i>Save changes
                        </button>

                        <button type="submit" asp-page-handler="UseDefaultPhoto" class="btn btn-outline-secondary">
                            Use default photo
                        </button>

                        <button type="submit" asp-page-handler="RemovePhoto" class="btn btn-outline-danger">
                            Remove photo
                        </button>
                    </div>
                </aside>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script src="~/js/edit-profile.js" asp-append-version="true"></script>
}
