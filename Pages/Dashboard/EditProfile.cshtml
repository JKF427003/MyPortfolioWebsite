@page
@model MyPortfolioWebsite.Pages.Dashboard.EditProfileModel
@{
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Profile";

    var googlePic = User.FindFirst("urn:google:picture")?.Value;
    var displayPic = Model.Profile.ProfilePictureUrl ?? googlePic ?? "/images/default-profile.png";

    if (!string.IsNullOrEmpty(displayPic) && displayPic.StartsWith("/uploads"))
    {
        displayPic += "?v=" + DateTime.UtcNow.Ticks;   
    }
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="row justify-content-center">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="card-title text-primary mb-3"><i class="bi bi-gear me-2"></i>Edit Profile</h2>

                    <form method="post" enctype="multipart/form-data" class="mt-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Profile.FirstName">Name</label>
                                    <input asp-for="Profile.FirstName" class="form-control" />
                                    <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.LastName">Surname</label>
                                    <input asp-for="Profile.LastName" class="form-control" />
                                    <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.Email">Primary Email</label>
                                    <input asp-for="Profile.Email" class="form-control" readonly />
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.AlternateEmail">Alternate Email</label>
                                    <input asp-for="Profile.AlternateEmail" class="form-control" />
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.DateOfBirth">Date of Birth</label>
                                    <input asp-for="Profile.DateOfBirth" type="date" class="form-control" />
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.Gender">Gender</label>
                                    <select asp-for="Profile.Gender" class="form-control">
                                        <option value="">-- Select Gender --</option>
                                        <option>Male</option>
                                        <option>Female</option>
                                        <option>Unspecified</option>
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.Description">Description</label>
                                    <textarea asp-for="Profile.Description" class="form-control"></textarea>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Profile.AccountCreated">Account Created</label>
                                    <input value="@Model.Profile.AccountCreated.ToString("yyyy-MM-dd")" class="form-control" readonly />
                                </div>

                                <div class="col-md-6 text-center">
                                    <label>Profile Picture</label>
                                    <div class="mb-2">
                                        <img src="@Model.Profile.ProfilePictureUrl" class="rounded-circle shadow" width="150" height="150" />
                                    </div>
                                    <div class="mb-3">
                                        <input type="file" name="ProfilePictureFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                        <div class="form-text">JPG/JPEG/PNG/WEBP, max 2 MB</div>
                                    </div>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="submit" asp-page-handler="RemovePhoto" class="btn btn-outline-danger">Remove Photo</button>
                                        <button type="submit" asp-page-handler="UseDefaultPhoto" class="btn btn-outline-secondary">Use Default</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <partial name="_ValidationScriptsPartial" />
}
