@page
@model MyPortfolioWebsite.Pages.Dashboard.UpdateLogModel
@{
    ViewData["Title"] = "Update Log";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="profile-page">
    <div class="profile-header">
        <div class="profile-title">
            <span class="profile-icon">
                <i class="bi bi-clock-history"></i>
            </span>
            <div>
                <p class="eyebrow">Dashboard</p>
                <h1>Update log</h1>
                <p class="profile-subtitle">Track changes and improvements made to the portfolio platform.</p>
            </div>
        </div>
    </div>

    <div class="profile-panel">
        <div class="dashboard-panel-header">
            <div>
                <p class="eyebrow">Current version</p>
                <h2>@Model.CurrentVersion</h2>
            </div>
        </div>

        <div class="update-log-list">
            @foreach (var entry in Model.Changelog)
            {
                <div class="update-log-item">
                    <span class="update-log-icon">
                        <i class="bi bi-check2"></i>
                    </span>
                    <span>@entry</span>
                </div>
            }
        </div>
    </div>
</div>