@page
@model MyPortfolioWebsite.Pages.Dashboard.UpdateLogModel
@{
    ViewData["Title"] = "Update Log";
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h2 class="card-title text-primary mb-3"><i class="bi bi-clock-history"></i>Update Log</h2>

            <p class="mb-4">
                <span class="fw-semibold text-dark">Current Version:</span>
                <span class="badge bg-primary">@Model.CurrentVersion</span>
            </p>

            <div class="list-group">
                @foreach (var entry in Model.Changelog)
                {
                    <div class="list-group-item list-group-item-action d-flex gap-2 align-items-start">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i><span>@entry</span>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
