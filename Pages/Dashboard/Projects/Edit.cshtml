@page "{id:int}"
@model MyPortfolioWebsite.Pages.Dashboard.Projects.EditModel
@{
    Layout = "~/Pages/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Edit Project";
}

<div class="profile-page">
    <div class="profile-header">
        <div class="profile-title">
            <span class="profile-icon">
                <i class="bi bi-pencil-square"></i>
            </span>
            <div>
                <p class="eyebrow">Portfolio</p>
                <h1>Edit project</h1>
                <p class="profile-subtitle">Update this project’s details, links, and cover image.</p>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="profile-panel">
        <input type="hidden" asp-for="Project.Id" />

        <section class="settings-section">
            <h2>Project details</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Project.Title" class="form-label">Project name</label>
                    <input asp-for="Project.Title" class="form-control" />
                    <span asp-validation-for="Project.Title" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Project.ProgrammingLanguages" class="form-label">Programming languages</label>
                    <input asp-for="Project.ProgrammingLanguages" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Project.ShortSummary" class="form-label">Short summary</label>
                    <input asp-for="Project.ShortSummary" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Project.Description" class="form-label">Description</label>
                    <textarea asp-for="Project.Description" class="form-control" rows="6"></textarea>
                </div>
            </div>
        </section>

        <section class="settings-section">
            <h2>Links and media</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Project.GitHubUrl" class="form-label">GitHub link</label>
                    <input asp-for="Project.GitHubUrl" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Project.LiveDemoUrl" class="form-label">Live demo link</label>
                    <input asp-for="Project.LiveDemoUrl" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Current cover image</label>

                    @if (!string.IsNullOrWhiteSpace(Model.Project.CoverImageUrl))
                    {
                        <div class="project-edit-cover">
                            <img src="@Model.Project.CoverImageUrl" alt="@Model.Project.Title" />
                        </div>
                    }
                    else
                    {
                        <div class="form-text">No cover image uploaded yet.</div>
                    }
                </div>

                <div class="col-12">
                    <label class="form-label">Replace cover image</label>
                    <input type="file" name="CoverImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">Optional. Uploading a new image replaces the current cover.</div>
                    <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Add gallery images</label>
                    <input type="file" name="GalleryImageFiles" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple />
                    <div class="form-text">Optional. Add more screenshots or supporting images.</div>
                    <span asp-validation-for="GalleryImageFiles" class="text-danger"></span>
                </div>
            </div>
        </section>

        @if (Model.Project.Images.Any())
        {
            <section class="settings-section">
                <h2>Gallery images</h2>

                <div class="project-gallery-manage">
                    @foreach (var image in Model.Project.Images)
                    {
                        <div class="project-gallery-manage-item">
                            <img src="@image.ImageUrl" alt="@Model.Project.Title gallery image" />

                            <button type="submit"
                                    asp-page-handler="RemoveGalleryImage"
                                    asp-route-id="@Model.Project.Id"
                                    asp-route-imageId="@image.Id"
                                    class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Remove
                            </button>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="d-flex justify-content-end gap-2">
            <a asp-page="/Dashboard/EditPortfolio" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-1"></i>Save changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}